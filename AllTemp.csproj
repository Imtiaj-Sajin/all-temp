<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AllTemp</AssemblyName>
    <RootNamespace>AllTemp</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\AllTemp.ico</ApplicationIcon>
    <Product>AllTemp</Product>
    <Company>Imtiaj Sajin</Company>
    <Description>AllTemp - all temperatures in one overlay</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Dev-only: `dotnet build -p:DevNoAdmin=true` runs without the UAC prompt (CPU/disk temps will be missing). -->
  <PropertyGroup Condition="'$(DevNoAdmin)' == 'true'">
    <ApplicationManifest />
    <DefineConstants>$(DefineConstants);DEV_NO_ADMIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- Official signed PawnIO installer, embedded unmodified and run silently on first launch (see DriverSetup.cs). -->
  <PropertyGroup>
    <PawnIoVersion>2.2.0</PawnIoVersion>
    <PawnIoSha256>1F519A22E47187F70A1379A48CA604981C4FCF694F4E65B734AAA74A9FBA3032</PawnIoSha256>
    <PawnIoFile>$(BaseIntermediateOutputPath)PawnIO-$(PawnIoVersion)\PawnIO_setup.exe</PawnIoFile>
  </PropertyGroup>

  <Target Name="BundlePawnIo" BeforeTargets="BeforeBuild">
    <DownloadFile Condition="!Exists('$(PawnIoFile)')"
                  SourceUrl="https://github.com/namazso/PawnIO.Setup/releases/download/$(PawnIoVersion)/PawnIO_setup.exe"
                  DestinationFolder="$([System.IO.Path]::GetDirectoryName('$(PawnIoFile)'))" />
    <VerifyFileHash File="$(PawnIoFile)" Hash="$(PawnIoSha256)" Algorithm="SHA256" />
    <ItemGroup>
      <EmbeddedResource Include="$(PawnIoFile)" LogicalName="AllTemp.PawnIO_setup.exe" />
    </ItemGroup>
  </Target>

</Project>
